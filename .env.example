# Desenvolvimento (npm run dev, mobile:debug). Copie para `.env` e ajuste.
# Variaveis em docs/ambiente-e-build.md -> "Ambientes".

NEXT_PUBLIC_APP_NAME=Base Multiplataforma
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# API de acesso (login/sessao) e das entidades; vazias -> dev-backend (so em dev).
NEXT_PUBLIC_ACESSO_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BRAND=

# Ferramentas de desenvolvimento (bloqueadas no build de homolog/producao).
NEXT_PUBLIC_DEVELOPER_MODE=true
NEXT_PUBLIC_SYSTEM_PANEL_ENABLED=true

# Acesso rapido contra a API (docs/ferramentas-dev.md); use um usuario de teste.
# NEXT_PUBLIC_DEV_QUICK_LOGIN=<login>
# NEXT_PUBLIC_DEV_QUICK_PASSWORD=<senha>

# Porta do npm run dev (padrao 3000).
# PORT=3000
