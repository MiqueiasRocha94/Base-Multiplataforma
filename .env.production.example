# Producao (npm run production, apk:production, docker/web.Dockerfile). Copie para `.env.production` e ajuste.
# Variaveis em docs/ambiente-e-build.md -> "Ambientes".

NEXT_PUBLIC_APP_NAME=Base Multiplataforma
NEXT_PUBLIC_API_URL=https://app.exemplo.com/api
# Obrigatoria fora de dev (sem dev-backend no build).
NEXT_PUBLIC_ACESSO_API_URL=https://acesso.exemplo.com
NEXT_PUBLIC_API_BASE_URL=https://api.exemplo.com
# Marca (white-label); fixada pelo compose de producao.
NEXT_PUBLIC_BRAND=

# Ferramentas de desenvolvimento: o build falha se estiverem true.
NEXT_PUBLIC_DEVELOPER_MODE=false
NEXT_PUBLIC_SYSTEM_PANEL_ENABLED=false

# Atualizacao remota do app (docs/ambiente-e-build.md -> "Atualizacao remota do app").
# NEXT_PUBLIC_APP_UPDATE_URL=https://app.exemplo.com/app-updates/manifest.json
