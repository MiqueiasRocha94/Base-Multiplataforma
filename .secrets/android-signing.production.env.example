# Assinatura do APK de PRODUCAO.
# Copie este arquivo para `android-signing.production.env` (sem .example) e
# preencha com o SEU keystore. O arquivo sem .example e ignorado pelo git.
#
# NUNCA comite o keystore nem as senhas. Guarde o keystore de producao com
# seguranca: perde-lo impede publicar atualizacoes do app na Play Store.
#
# (Alternativa a este arquivo: definir estas mesmas variaveis no ambiente/CI.)

# Caminho do keystore (relativo a raiz do projeto ou absoluto).
ANDROID_KEYSTORE_FILE=.secrets/release-production.jks

# Senha do keystore.
ANDROID_KEYSTORE_PASSWORD=

# Alias da chave dentro do keystore.
ANDROID_KEY_ALIAS=release

# Senha da chave.
ANDROID_KEY_PASSWORD=
