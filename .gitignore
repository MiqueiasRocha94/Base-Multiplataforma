# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm só como gerenciador local (store compartilhado entre projetos); o
# repositório segue o npm (package-lock.json)
/pnpm-lock.yaml
/pnpm-workspace.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea
/android
/ios
/references
/references/*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# android signing: keystore + senhas — NUNCA commitar (exceto os *.example)
/.secrets/*
!/.secrets/*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.notfound-catchall.disabled/

# Área de trabalho local dos agentes (estado, handoffs, planos) — não versionar
/.agents/workspace/

# certificado do npm run dev:https (scripts/dev-https-cert.mjs)
/certificates/

# entrada de build sem codigo de dev (scripts/prepare-dist-source.mjs) e artefatos montados
/.dist-build/
/.dist-build-dev/
# artefatos da esteira emulada (docker/ci): APK e keystore temporario
/builds/
/dist/
# material das lojas montado (scripts/store/montar-material.mjs); a fonte em store/ é versionada
/store/build/
