{
  "name": "multplataforma-base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/run-next-with-env.mjs dev",
    "start": "node ./scripts/build-target.mjs web --env=homolog && node ./scripts/run-next-with-env.mjs start --env=homolog",
    "production": "node ./scripts/build-target.mjs web --env=production && node ./scripts/run-next-with-env.mjs start --env=production",
    "mobile:debug": "node ./scripts/android-build.mjs --debug --env=development",
    "apk": "node ./scripts/android-build.mjs --env=homolog",
    "apk:production": "node ./scripts/android-build.mjs --env=production",
    "apk:image": "docker compose build apk",
    "apk:docker": "docker compose run --rm apk",
    "apk:docker:prod": "docker compose run --rm -e APP_ENV=production apk",
    "web:image": "docker compose build web",
    "web:up": "docker compose up --build web",
    "web:down": "docker compose down",
    "docs:diagrams": "node ./scripts/docs-diagrams.mjs",
    "env:check": "node ./scripts/validate-build-env.mjs",
    "lint": "eslint .",
    "release": "commit-and-tag-version",
    "cap:sync": "node ./scripts/build-target.mjs mobile --env=production --sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@faker-js/faker": "^10.5.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lorem-ipsum": "^3.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "recharts": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
