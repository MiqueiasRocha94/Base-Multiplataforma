{
  "name": "multplataforma-base",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/run-next-with-env.mjs dev",
    "dev:https": "node ./scripts/run-next-with-env.mjs dev --https",
    "start": "node ./scripts/build-target.mjs web --env=homolog && node ./scripts/serve-dist.mjs --env=homolog",
    "production": "node ./scripts/build-target.mjs web --env=production && node ./scripts/serve-dist.mjs --env=production",
    "dist:check": "node ./scripts/prepare-dist-source.mjs",
    "verify:dist": "node ./scripts/verify-dist.mjs",
    "mobile:debug": "node ./scripts/android-build.mjs --debug --env=development",
    "apk": "node ./scripts/android-build.mjs --env=homolog",
    "apk:production": "node ./scripts/android-build.mjs --env=production",
    "app-update:bundle": "node ./scripts/app-update-bundle.mjs",
    "desktop:debug": "node ./scripts/desktop-build.mjs --debug --env=development",
    "desktop": "node ./scripts/desktop-build.mjs --env=homolog",
    "desktop:production": "node ./scripts/desktop-build.mjs --env=production",
    "docker:image:android": "docker compose -f docker/develop/app/docker-compose.yml build app",
    "docker:image:desktop:windows": "docker compose -f docker/develop/desktop/docker-compose.yml build windows",
    "docker:image:desktop:linux": "docker compose -f docker/develop/desktop/docker-compose.yml build linux",
    "docker:develop:app": "docker compose -f docker/develop/app/docker-compose.yml run --rm app",
    "docker:develop:desktop:windows": "docker compose -f docker/develop/desktop/docker-compose.yml run --rm windows",
    "docker:develop:desktop:linux": "docker compose -f docker/develop/desktop/docker-compose.yml run --rm linux",
    "docker:homolog:web:image": "docker compose -f docker/homolog/web/docker-compose.yml build web",
    "docker:homolog:web": "docker compose -f docker/homolog/web/docker-compose.yml up --build web",
    "docker:homolog:web:down": "docker compose -f docker/homolog/web/docker-compose.yml down",
    "docker:homolog:app": "docker compose -f docker/homolog/app/docker-compose.yml run --rm app",
    "docker:homolog:desktop:windows": "docker compose -f docker/homolog/desktop/docker-compose.yml run --rm windows",
    "docker:homolog:desktop:linux": "docker compose -f docker/homolog/desktop/docker-compose.yml run --rm linux",
    "docker:production:web:image": "docker compose -f docker/production/web/docker-compose.yml build web",
    "docker:production:web": "docker compose -f docker/production/web/docker-compose.yml up --build web",
    "docker:production:web:down": "docker compose -f docker/production/web/docker-compose.yml down",
    "docker:production:desktop:windows": "docker compose -f docker/production/desktop/docker-compose.yml run --rm windows",
    "docker:production:desktop:linux": "docker compose -f docker/production/desktop/docker-compose.yml run --rm linux",
    "docker:ci": "docker compose -f docker/ci/docker-compose.yml run --rm pipeline",
    "docs:diagrams": "node ./scripts/docs-diagrams.mjs",
    "env:check": "node ./scripts/validate-build-env.mjs",
    "lint": "eslint .",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:history": "node ./scripts/release/calcular-versao-historico.mjs",
    "cap:sync": "node ./scripts/build-target.mjs mobile --env=production --sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "check:arch": "node scripts/check-architecture.mjs && node scripts/agents/sync-agents.mjs --check && node scripts/gen-src-map.mjs --check",
    "agents:sync": "node scripts/agents/sync-agents.mjs",
    "agents:check": "node scripts/agents/sync-agents.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs scripts/store/*.test.mjs scripts/pwa/*.test.mjs",
    "store:novidades": "node scripts/store/rascunhar-novidades.mjs --idioma pt-BR --versao",
    "store:montar": "node scripts/store/montar-material.mjs",
    "store:validar": "node scripts/store/validar-material.mjs",
    "pwa:validar": "node scripts/pwa/validar-pwa.mjs --manifest public/manifest.webmanifest --public public",
    "docs:src-map": "node scripts/gen-src-map.mjs",
    "deps:check": "node ./scripts/deps-outdated.mjs",
    "ci:run": "node ./scripts/ci.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@capawesome/capacitor-live-update": "^8.7.1",
    "@faker-js/faker": "^10.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lorem-ipsum": "^3.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "recharts": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fflate": "^0.8.3",
    "semantic-release": "25.0.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
